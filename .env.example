# Server-only. Run npm run configure:local to set this in ignored .env.local.
# Use the Operations project's Postgres connection string, preferably its
# session pooler when direct IPv6 connectivity is unavailable.
SAR_OPS_DATABASE_URL=
SAR_ANTHROPIC_MODEL=claude-sonnet-5-5
# The Anthropic key: EITHER set it here (server-only, simplest) ...
SAR_ANTHROPIC_API_KEY=
# ... OR leave this blank and store it in Operations Vault as sar2-anthropic-key via npm run configure:local.
# Never put either credential in a VITE_ variable.
